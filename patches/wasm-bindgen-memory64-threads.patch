+fn pointer_type(memory64: bool) -> ValType {
+    if memory64 {
+        ValType::I64
+    } else {
+        ValType::I32
+    }
+}
+
+fn wasm_bindgen_word_type(memory64: bool) -> ValType {
+    if memory64 {
+        ValType::F64
+    } else {
+        ValType::I32
+    }
+}
+
+fn pointer_const_expr(memory64: bool, value: u64) -> ConstExpr {
+    if memory64 {
+        ConstExpr::Value(Value::I64(value as i64))
+    } else {
+        ConstExpr::Value(Value::I32(value as i32))
+    }
+}
+
+fn pointer_const(body: &mut InstrSeqBuilder<'_>, memory64: bool, value: u64) {
+    if memory64 {
+        body.i64_const(value as i64);
+    } else {
+        body.i32_const(value as i32);
+    }
+}
+
+fn invalid_pointer_const(body: &mut InstrSeqBuilder<'_>, memory64: bool) {
+    if memory64 {
+        body.i64_const(i64::MIN);
+    } else {
+        body.i32_const(i32::MIN);
+    }
+}
+
+fn wasm_bindgen_word_is_nonzero(body: &mut InstrSeqBuilder<'_>, memory64: bool) {
+    if memory64 {
+        body.unop(walrus::ir::UnaryOp::I64TruncUSatF64)
+            .unop(walrus::ir::UnaryOp::I64Eqz)
+            .unop(walrus::ir::UnaryOp::I32Eqz);
+    }
+}
+
+fn pointer_to_wasm_bindgen_word(body: &mut InstrSeqBuilder<'_>, memory64: bool) {
+    if memory64 {
+        body.unop(walrus::ir::UnaryOp::F64ConvertUI64);
+    }
+}
+
+fn size_to_wasm_bindgen_word(body: &mut InstrSeqBuilder<'_>, memory64: bool) {
+    if memory64 {
+        body.unop(walrus::ir::UnaryOp::I64ExtendUI32)
+            .unop(walrus::ir::UnaryOp::F64ConvertUI64);
+    }
+}
+
+fn wasm_bindgen_word_const(body: &mut InstrSeqBuilder<'_>, memory64: bool, value: u64) {
+    if memory64 {
+        body.f64_const(value as f64);
+    } else {
+        body.i32_const(value as i32);
+    }
+}
